  "uniform_gamma_q": 1.0,
  "uniform_gamma_y": 1.0,
  "uniform_gamma_e": 0.0,
  "learnable_kgau_gammas": true,
  "log_kgau_gamma_lr": 0.5,
  "gamma_linear_schedule": true,
  "gamma_schedule_end": 0.1,
  "gamma_schedule_start_epoch": 0,
  "gamma_schedule_epochs": 0
}
